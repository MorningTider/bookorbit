#!/bin/sh
set -eu
exec /usr/bin/python3 - <<'PY'
import pathlib,platform,sys
if platform.machine()!='x86_64' or sys.version_info<(3,8):raise SystemExit('Native acceptance requires x86_64 DSM and system Python3.8 or newer')
if not pathlib.Path('/var/packages/postgresql18/target/bin/pg_admin.py').is_file():raise SystemExit('Install the native PostgreSQL18 package before this acceptance candidate')
PY
